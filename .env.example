# Chon dung MOT provider bang LLM_PROVIDER, roi dien credential cua provider do.
# Ho tro: gemini | openai | anthropic | openrouter | ollama | custom

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# --- gemini (mac dinh) ---
GOOGLE_API_KEY=

# --- openai ---
# Doi sang OpenAI: dat LLM_PROVIDER=openai va LLM_MODEL=gpt-4o-mini (hoac model khac).
# OPENAI_BASE_URL de mac dinh la endpoint chinh thuc; chi doi khi dung proxy,
# Azure gateway hoac endpoint noi bo tuong thich OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI la provider fallback: neu provider dang chon thieu key ma OPENAI_API_KEY
# co gia tri thi pipeline tu chuyen sang OpenAI voi model duoi day (va in canh bao).
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- anthropic ---
ANTHROPIC_API_KEY=

# --- openrouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- ollama (chay local, khong can key) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- endpoint tuy y tuong thich OpenAI ---
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Crossref ---
# Gui mailto vao polite pool cua Crossref de giam kha nang bi 429.
CROSSREF_MAILTO=student@vinuni.edu.vn

# --- co tuy chon ---
# REFRESH_SOURCE=1     fetch lai tu Crossref thay vi dung data/raw/ co san
# REFRESH_TEST_SET=1   sinh lai test set (canh bao: metric het so sanh duoc voi lan truoc)
# RUN_RAGAS=1          bat vong danh gia Ragas (cham)
